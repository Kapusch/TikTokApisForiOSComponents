<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.kapusch.tiktokbusinessios.sample</ApplicationId>
    <ApplicationTitle>Kapusch TikTok Business iOS Sample</ApplicationTitle>
    <UseKapuschTikTokBusinessIosInteropFromSource>true</UseKapuschTikTokBusinessIosInteropFromSource>
    <NoWarn>$(NoWarn);CA1422</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <_SampleInfoPlist>$(MSBuildThisFileDirectory)Info.plist</_SampleInfoPlist>
    <_SampleInfoPlistTemplate>$(MSBuildThisFileDirectory)Info.template.plist</_SampleInfoPlistTemplate>
    <ApplicationManifest>$(_SampleInfoPlist)</ApplicationManifest>
  </PropertyGroup>
  <!-- Info.plist is untracked: copy the secret-free template on first build, then fill local values. -->
  <Target Name="KapuschTikTokBusinessSample_EnsureInfoPlist" BeforeTargets="PrepareForBuild">
    <Copy
      Condition="!Exists('$(_SampleInfoPlist)') and Exists('$(_SampleInfoPlistTemplate)')"
      SourceFiles="$(_SampleInfoPlistTemplate)"
      DestinationFiles="$(_SampleInfoPlist)"
    />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Kapusch.TikTok.Business.iOS/Kapusch.TikTok.Business.iOS.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../src/Kapusch.TikTok.Business.iOS/buildTransitive/Kapusch.TikTok.Business.iOS.props" />
  <Import Project="$(MSBuildThisFileDirectory)../../src/Kapusch.TikTok.Business.iOS/buildTransitive/Kapusch.TikTok.Business.iOS.targets" />
</Project>
